classDiagram
    class Owner {
        +String name
        +String info
    }

    class Pet {
        +String name
        +String info
    }

    class Task {
        +String name
        +String category
        +int duration
        +String priority
        +addTask()
        +editTask()
        +removeTask()
    }

    class Scheduler {
        +List~Task~ scheduledTasks
        +scheduleTask()
        +getTodaysTasks()
    }

    Owner "1" --> "1..*" Pet : owns
    Pet "1" --> "0..*" Task : needs
    Scheduler "1" o-- "0..*" Task : schedules
    Scheduler ..> Owner : uses